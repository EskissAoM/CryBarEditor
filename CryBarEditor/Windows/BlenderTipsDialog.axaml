<Window
	x:Class="CryBarEditor.Windows.BlenderTipsDialog"
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:micons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
	Title="Blender export &amp; tagging tips"
	Width="680"
	Height="700"
	d:DesignHeight="660"
	d:DesignWidth="680"
	Background="#141414"
	Foreground="#d9d9d9"
	WindowStartupLocation="CenterOwner"
	CanResize="True"
	mc:Ignorable="d">
	<Border Padding="14">
		<DockPanel>
			<!-- Bottom: close button -->
			<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
				<Button Content="Close" Click="CloseClick" IsCancel="True" IsDefault="True" />
			</StackPanel>

			<!-- Title -->
			<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
				<micons:MaterialIcon Kind="InformationOutline" Width="22" Height="22" Foreground="#77c1e0" VerticalAlignment="Center" />
				<TextBlock Text="Blender export &amp; tagging tips" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
			</StackPanel>

			<!-- Scrollable body -->
			<ScrollViewer VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="16">

					<!-- Section 1: Export checklist with required/optional badges. Labels match Blender 4.x glTF export UI. -->
					<StackPanel Spacing="4">
						<TextBlock Text="Export checklist" FontWeight="Bold" FontSize="16" />
						<TextBlock Foreground="#888" FontSize="12" Text="File → Export → glTF 2.0 (.glb/.gltf)" />

						<Border BorderBrush="#333" BorderThickness="1" Margin="0,6,0,0">
							<Grid ColumnDefinitions="86,250,*" RowDefinitions="Auto,Auto,Auto,Auto">
								<!-- Header row -->
								<Border Grid.Row="0" Grid.Column="0" Background="#1c1c1c" Padding="8,5">
									<TextBlock Text="Status" FontWeight="Bold" FontSize="13" Foreground="#d9d9d9" />
								</Border>
								<Border Grid.Row="0" Grid.Column="1" Background="#1c1c1c" Padding="8,5">
									<TextBlock Text="Setting" FontWeight="Bold" FontSize="13" Foreground="#d9d9d9" />
								</Border>
								<Border Grid.Row="0" Grid.Column="2" Background="#1c1c1c" Padding="8,5">
									<TextBlock Text="Why" FontWeight="Bold" FontSize="13" Foreground="#d9d9d9" />
								</Border>

								<!-- Required: Custom Properties ON -->
								<Border Grid.Row="1" Grid.Column="0" Padding="8,7" BorderBrush="#222" BorderThickness="0,1,0,0">
									<Border Background="#3a1212" BorderBrush="#f55142" BorderThickness="1"
											CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Top">
										<TextBlock Text="REQUIRED" Foreground="#f5b0a0" FontSize="11" FontWeight="Bold" />
									</Border>
								</Border>
								<Border Grid.Row="1" Grid.Column="1" Padding="8,7" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Include → Custom Properties = ON" Foreground="#cfd8e8" FontSize="13" FontWeight="Bold" />
								</Border>
								<Border Grid.Row="1" Grid.Column="2" Padding="8,7" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Foreground="#b0b0b0" FontSize="12" TextWrapping="Wrap"
									           Text="Without it, Blender drops every CryBar tag at export. Applies to both fresh GLBs and round-trips." />
								</Border>

								<!-- Optional: Always Sample OFF -->
								<Border Grid.Row="2" Grid.Column="0" Padding="8,7" BorderBrush="#222" BorderThickness="0,1,0,0">
									<Border Background="#1c1c1c" BorderBrush="#666" BorderThickness="1"
											CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Top">
										<TextBlock Text="OPTIONAL" Foreground="#a0a0a0" FontSize="11" FontWeight="Bold" />
									</Border>
								</Border>
								<Border Grid.Row="2" Grid.Column="1" Padding="8,7" BorderBrush="#222" BorderThickness="0,1,0,0">
									<StackPanel>
										<TextBlock Text="Animation → Always Sample" Foreground="#cfd8e8" FontSize="13" FontWeight="Bold" />
										<TextBlock Text="OFF recommended" Foreground="#a0d8a0" FontSize="12" />
									</StackPanel>
								</Border>
								<Border Grid.Row="2" Grid.Column="2" Padding="8,7" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Foreground="#b0b0b0" FontSize="12" TextWrapping="Wrap"
									           Text="OFF preserves original keyframes; ON re-samples at scene FPS (slight drift). Either works." />
								</Border>

								<!-- Optional: Tangents -->
								<Border Grid.Row="3" Grid.Column="0" Padding="8,7" BorderBrush="#222" BorderThickness="0,1,0,0">
									<Border Background="#1c1c1c" BorderBrush="#666" BorderThickness="1"
											CornerRadius="3" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Top">
										<TextBlock Text="OPTIONAL" Foreground="#a0a0a0" FontSize="11" FontWeight="Bold" />
									</Border>
								</Border>
								<Border Grid.Row="3" Grid.Column="1" Padding="8,7" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Mesh → Tangents" Foreground="#cfd8e8" FontSize="13" FontWeight="Bold" />
								</Border>
								<Border Grid.Row="3" Grid.Column="2" Padding="8,7" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Foreground="#b0b0b0" FontSize="12" TextWrapping="Wrap"
									           Text="OFF: CryBar recomputes via MikkTSpace (identical result, smaller file)." />
								</Border>
							</Grid>
						</Border>
					</StackPanel>

					<!-- Separator -->
					<Border BorderBrush="#333" BorderThickness="0,1,0,0" />

					<!-- Section 2: Recognized tags table - all OPTIONAL -->
					<StackPanel Spacing="6">
						<StackPanel Orientation="Horizontal" Spacing="6">
							<TextBlock Text="Tags you can author" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
							<Border Background="#1c1c1c" BorderBrush="#666" BorderThickness="1"
									CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
								<TextBlock Text="ALL OPTIONAL" Foreground="#a0a0a0" FontSize="11" FontWeight="Bold" />
							</Border>
						</StackPanel>
						<TextBlock Foreground="#b0b0b0" FontSize="12" TextWrapping="Wrap"
						           Text="Author these to drive the GLB → TMM conversion: name attachments, place impact points, set bounds and other TMM fields. All use Custom Property name 'crybar' on the relevant Object." />
						<TextBlock Foreground="#888" FontSize="12" TextWrapping="Wrap"
						           Text="If you started from an existing TMM, CryBar already auto-stamped these onto the mesh node at export - so a Blender round-trip preserves everything without any manual work. You only need to author them when building a GLB from scratch or overriding an auto-stamped value." />

						<Border BorderBrush="#333" BorderThickness="1" Margin="0,4,0,0">
							<Grid ColumnDefinitions="260,140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
								<!-- Header row -->
								<Border Grid.Row="0" Grid.Column="0" Background="#1c1c1c" Padding="8,5">
									<TextBlock Text="Property name &amp; value" FontWeight="Bold" FontSize="13" Foreground="#d9d9d9" />
								</Border>
								<Border Grid.Row="0" Grid.Column="1" Background="#1c1c1c" Padding="8,5">
									<TextBlock Text="Goes on" FontWeight="Bold" FontSize="13" Foreground="#d9d9d9" />
								</Border>
								<Border Grid.Row="0" Grid.Column="2" Background="#1c1c1c" Padding="8,5">
									<TextBlock Text="When you'd want it" FontWeight="Bold" FontSize="13" Foreground="#d9d9d9" />
								</Border>

								<!-- Attachment row -->
								<Border Grid.Row="1" Grid.Column="0" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<SelectableTextBlock Text='crybar = {"node_type":"attachment"}' FontFamily="Consolas" FontSize="12" Foreground="#cfd8e8" />
								</Border>
								<Border Grid.Row="1" Grid.Column="1" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Empty" FontSize="12" Foreground="#b0b0b0" />
								</Border>
								<Border Grid.Row="1" Grid.Column="2" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Adding a new VFX hookup (e.g. vfx_attack) to a custom-rigged model. The Empty's name becomes the attachment name; its parent bone becomes the attachment's parent." FontSize="12" TextWrapping="Wrap" Foreground="#b0b0b0" />
								</Border>

								<!-- Impact point row -->
								<Border Grid.Row="2" Grid.Column="0" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<SelectableTextBlock Text='crybar = {"node_type":"impact_point"}' FontFamily="Consolas" FontSize="12" Foreground="#cfd8e8" />
								</Border>
								<Border Grid.Row="2" Grid.Column="1" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Empty" FontSize="12" Foreground="#b0b0b0" />
								</Border>
								<Border Grid.Row="2" Grid.Column="2" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Adding a new corpse / weapon-hit position. The Empty's translation becomes the impact-point coordinates." FontSize="12" TextWrapping="Wrap" Foreground="#b0b0b0" />
								</Border>

								<!-- Main matrix legacy row -->
								<Border Grid.Row="3" Grid.Column="0" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<SelectableTextBlock Text='crybar = {"main_matrix":[16 floats]}' FontFamily="Consolas" FontSize="12" Foreground="#cfd8e8" />
								</Border>
								<Border Grid.Row="3" Grid.Column="1" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Armature / Mesh" FontSize="12" Foreground="#b0b0b0" />
								</Border>
								<Border Grid.Row="3" Grid.Column="2" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Overriding the model's MainMatrix (row-major 4x4 - typical use is uniform scale). Shorthand for tmm.main_matrix below; either form works." FontSize="12" TextWrapping="Wrap" Foreground="#b0b0b0" />
								</Border>

								<!-- TMM overrides row -->
								<Border Grid.Row="4" Grid.Column="0" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<SelectableTextBlock Text='crybar = {"tmm": {"extended_bbox":[6 floats], "bounds_radius":1.07, "submodels":["default"], ...}}' FontFamily="Consolas" FontSize="12" Foreground="#cfd8e8" TextWrapping="Wrap" />
								</Border>
								<Border Grid.Row="4" Grid.Column="1" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Armature / Mesh" FontSize="12" Foreground="#b0b0b0" />
								</Border>
								<Border Grid.Row="4" Grid.Column="2" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Overriding any TMM-level field. Recognized keys: main_matrix, extended_bbox, bounds_radius, submodels, autoburn_mode, raytracing, terrain_emb, modified_bones, bone_collisions, auto_attach, attachments, lossy_sections. Only include the keys you want to override - the rest stay at the auto-stamped values." FontSize="12" TextWrapping="Wrap" Foreground="#b0b0b0" />
								</Border>
							</Grid>
						</Border>
					</StackPanel>

					<!-- Separator -->
					<Border BorderBrush="#333" BorderThickness="0,1,0,0" />

					<!-- Section 2b: Texture role mapping (glTF PBR slots -> AOMR texture roles). -->
					<StackPanel Spacing="6">
						<TextBlock Text="Texture role mapping" FontWeight="Bold" FontSize="16" />
						<TextBlock Foreground="#b0b0b0" FontSize="12" TextWrapping="Wrap"
						           Text="CryBar exports each AOMR texture into a standard glTF PBR slot. When you round-trip a GLB through Blender, putting a texture into the matching slot will land it back in the right .ddt:" />

						<Border BorderBrush="#333" BorderThickness="1" Margin="0,4,0,0">
							<Grid ColumnDefinitions="220,170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
								<!-- Header -->
								<Border Grid.Row="0" Grid.Column="0" Background="#1c1c1c" Padding="8,5">
									<TextBlock Text="glTF slot in material" FontWeight="Bold" FontSize="13" Foreground="#d9d9d9" />
								</Border>
								<Border Grid.Row="0" Grid.Column="1" Background="#1c1c1c" Padding="8,5">
									<TextBlock Text="AOMR role" FontWeight="Bold" FontSize="13" Foreground="#d9d9d9" />
								</Border>
								<Border Grid.Row="0" Grid.Column="2" Background="#1c1c1c" Padding="8,5">
									<TextBlock Text="Notes" FontWeight="Bold" FontSize="13" Foreground="#d9d9d9" />
								</Border>

								<!-- Base Color -->
								<Border Grid.Row="1" Grid.Column="0" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Base Color Texture" FontSize="12" Foreground="#cfd8e8" />
								</Border>
								<Border Grid.Row="1" Grid.Column="1" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="BaseColor" FontSize="12" Foreground="#b0b0b0" />
								</Border>
								<Border Grid.Row="1" Grid.Column="2" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Diffuse albedo. Round-trips as basename.ddt." FontSize="12" TextWrapping="Wrap" Foreground="#b0b0b0" />
								</Border>

								<!-- Normal -->
								<Border Grid.Row="2" Grid.Column="0" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Normal Texture" FontSize="12" Foreground="#cfd8e8" />
								</Border>
								<Border Grid.Row="2" Grid.Column="1" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Normals" FontSize="12" Foreground="#b0b0b0" />
								</Border>
								<Border Grid.Row="2" Grid.Column="2" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Tangent-space normal map. Round-trips as basename_normal.ddt." FontSize="12" TextWrapping="Wrap" Foreground="#b0b0b0" />
								</Border>

								<!-- ORM -->
								<Border Grid.Row="3" Grid.Column="0" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Metallic/Roughness AND Ambient Occlusion" FontSize="12" Foreground="#cfd8e8" TextWrapping="Wrap" />
								</Border>
								<Border Grid.Row="3" Grid.Column="1" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Masks (ORM)" FontSize="12" Foreground="#b0b0b0" />
								</Border>
								<Border Grid.Row="3" Grid.Column="2" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="One image with R=Occlusion, G=Roughness, B=Metallic. The same texture should be assigned to both glTF slots; CryBar writes it as basename_masks1.ddt." FontSize="12" TextWrapping="Wrap" Foreground="#b0b0b0" />
								</Border>

								<!-- Emissive -->
								<Border Grid.Row="4" Grid.Column="0" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Emissive Texture" FontSize="12" Foreground="#cfd8e8" />
								</Border>
								<Border Grid.Row="4" Grid.Column="1" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Masks2 (player color)" FontSize="12" Foreground="#b0b0b0" />
								</Border>
								<Border Grid.Row="4" Grid.Column="2" Padding="8,5" BorderBrush="#222" BorderThickness="0,1,0,0">
									<TextBlock Text="Single-channel player-color mask in R. The engine tints white pixels with the active player color; in Blender it previews as glow. Round-trips as basename_masks2.ddt." FontSize="12" TextWrapping="Wrap" Foreground="#b0b0b0" />
								</Border>
							</Grid>
						</Border>

						<TextBlock Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
						           Text="DDT encoder params (format, mip count, ...) ride in extras.crybar.ddt[] under keys {matName}, {matName}_normal, {matName}_masks1, {matName}_masks2. Set them via CryBar's GLB Convert dialog when authoring a new material from scratch in Blender; round-tripped GLBs carry them automatically." />
					</StackPanel>

					<!-- Separator -->
					<Border BorderBrush="#333" BorderThickness="0,1,0,0" />

					<!-- Section 3: How to add tags in Blender -->
					<StackPanel Spacing="6">
						<TextBlock Text="How to add a tag in Blender" FontWeight="Bold" FontSize="16" />
						<StackPanel Margin="0,2,0,0" Spacing="2">
							<TextBlock Foreground="#b0b0b0" TextWrapping="Wrap" FontSize="13" Text="1. In the 3D viewport, select the Empty object (or the Armature / Mesh, depending on which tag you're adding)." />
							<TextBlock Foreground="#b0b0b0" TextWrapping="Wrap" FontSize="13" Text="2. Properties Editor → Object Properties tab → scroll to the Custom Properties panel." />
							<TextBlock Foreground="#b0b0b0" TextWrapping="Wrap" FontSize="13" Text="3. Click New, then click the gear/edit icon next to the property:" />
							<TextBlock Foreground="#b0b0b0" TextWrapping="Wrap" FontSize="13" Margin="14,0,0,0" Text="• Property name:  crybar" />
							<TextBlock Foreground="#b0b0b0" TextWrapping="Wrap" FontSize="13" Margin="14,0,0,0" Text="• Type: Python" />
							<TextBlock Foreground="#b0b0b0" TextWrapping="Wrap" FontSize="13" Margin="14,0,0,0" Text="• Value: paste the value from the table above" />
							<TextBlock Foreground="#b0b0b0" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,0" Text="4. Make sure 'Include → Custom Properties' is enabled in the GLB export options (see checklist above)." />
						</StackPanel>

						<TextBlock Foreground="#888" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0">
							<Run Text="Or via the Scripting tab:  " />
							<Run FontFamily="Consolas" Foreground="#cfd8e8" Text='bpy.context.object["crybar"] = {"node_type": "attachment"}' />
						</TextBlock>
					</StackPanel>

					<!-- Separator -->
					<Border BorderBrush="#333" BorderThickness="0,1,0,0" />

					<!-- Section 4: Attachment Empty orientation -->
					<StackPanel Spacing="6">
						<TextBlock Text="Attachment Empty orientation" FontWeight="Bold" FontSize="16" />
						<TextBlock Foreground="#b0b0b0" FontSize="13" TextWrapping="Wrap"
						           Text="The Empty's rotation drives how the engine orients whatever mesh (sword, shield, vfx) gets attached at runtime. +Y in Blender becomes the 'forward' axis the engine uses." />
						<TextBlock Foreground="#b0b0b0" FontSize="13" TextWrapping="Wrap"
						           Text="The correct rotation depends on the attached mesh's natural pose, which varies per asset:" />
						<StackPanel Margin="14,0,0,0" Spacing="2">
							<TextBlock Foreground="#b0b0b0" FontSize="13" TextWrapping="Wrap" Text="- Most weapons assume +Y points along the blade, away from the grip." />
							<TextBlock Foreground="#b0b0b0" FontSize="13" TextWrapping="Wrap" Text="- Most shields assume +Y points outward, away from the body." />
							<TextBlock Foreground="#b0b0b0" FontSize="13" TextWrapping="Wrap" Text="- Asset-specific quirks exist: e.g. Melagius' shield is modeled standing on its rim with the flat back on +Y, so a unit using it needs the Empty's +Y rotated to point into the arm toward the hip." />
						</StackPanel>
						<TextBlock Foreground="#888" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
						           Text="If the attached object renders rotated wrong in-game, rotate the Empty in Blender until +Y points where that mesh's 'forward' actually is. There is no single rule - it depends on how the artist authored the attached asset." />
					</StackPanel>

				</StackPanel>
			</ScrollViewer>
		</DockPanel>
	</Border>
</Window>
