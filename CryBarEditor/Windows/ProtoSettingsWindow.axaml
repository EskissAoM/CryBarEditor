<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ce="using:CryBarEditor.Windows"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="280"
        x:Class="CryBarEditor.Windows.ProtoSettingsWindow"
        x:DataType="ce:ProtoSettingsWindow"
        Foreground="#d9d9d9"
        Background="#141414"
        WindowStartupLocation="CenterOwner"
        CanResize="False" Width="500" Height="280"
        Title="Proto Editor Settings">
    <Border Padding="15" BorderThickness="1" BorderBrush="#3f3f46">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Proto Editor Settings" FontWeight="Bold" FontSize="18" Margin="0,0,0,15" Foreground="#e3bd54" />

            <DockPanel DockPanel.Dock="Bottom" Margin="0,15,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Save" Click="Save_Click" Background="#4772b5" />
            </DockPanel>

            <StackPanel Spacing="15">
                <StackPanel>
                    <TextBlock Text="Data.bar Path" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding DataBarPath, Mode=TwoWay}" PlaceholderText="C:\...\Data.bar" />
                        <Button Grid.Column="1" Content="Browse..." Click="BrowseBar_Click" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="User Folder Path (Mods local output)" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding UserFolderPath, Mode=TwoWay}" PlaceholderText="C:\Users\...\Age of Mythology Retold\&lt;SteamID&gt;" />
                        <Button Grid.Column="1" Content="Browse..." Click="BrowseUser_Click" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
