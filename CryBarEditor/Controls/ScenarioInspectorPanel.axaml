<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:CryBarEditor.Controls"
             xmlns:micons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="CryBarEditor.Controls.ScenarioInspectorPanel"
             x:DataType="controls:ScenarioInspectorPanel"
             Width="280" Background="#161820">
    <DockPanel LastChildFill="True">

        <!-- Fixed metadata at top of inspector. Doesn't scroll with the rest. -->
        <Border DockPanel.Dock="Top" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="8">
            <TextBlock x:Name="_textureSummary" Text="(loading)"
                       Foreground="#ddd" FontFamily="Cascadia Code,Consolas"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- Action bar: save row + warnings + manual-BAR fallback. -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="8">
            <StackPanel Spacing="6">
                <TextBlock x:Name="_savePathLabel" Foreground="#888"
                           FontSize="11"
                           IsVisible="False"/>
                <Grid x:Name="_saveBarRow" ColumnDefinitions="Auto,*,Auto,Auto,Auto" IsVisible="False">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4"
                                VerticalAlignment="Bottom">
                        <StackPanel x:Name="_dirtyIndicator"
                                    Orientation="Horizontal" Spacing="6"
                                    IsVisible="False">
                            <Ellipse Width="10" Height="10" Fill="#FFB300" VerticalAlignment="Center"/>
                            <TextBlock Text="unsaved" Foreground="#FFB300" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button x:Name="_undoBtn" Click="OnUndoClick"
                                    Width="26" Height="26" Padding="0"
                                    Background="#2c3a4f" Foreground="#cfd8e8"
                                    ToolTip.Tip="Undo (Ctrl+Z)">
                                <micons:MaterialIcon Kind="Undo" Width="16" Height="16"/>
                            </Button>
                            <Button x:Name="_redoBtn" Click="OnRedoClick"
                                    Width="26" Height="26" Padding="0"
                                    Background="#2c3a4f" Foreground="#cfd8e8"
                                    ToolTip.Tip="Redo (Ctrl+Shift+Z)">
                                <micons:MaterialIcon Kind="Redo" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="_saveBtn" Content="Save"
                            Click="OnSaveClick" IsVisible="False" Margin="0,0,4,0"
                            VerticalAlignment="Bottom"
                            Background="#2c3a4f" Foreground="#cfd8e8" Padding="8,4"/>
                    <Button Grid.Column="3" x:Name="_saveAsBtn" Content="Save As..."
                            Click="OnSaveAsClick" Margin="0,0,4,0"
                            VerticalAlignment="Bottom"
                            Background="#2c3a4f" Foreground="#cfd8e8" Padding="8,4"/>
                    <Button Grid.Column="4" x:Name="_discardBtn" Content="Discard"
                            Click="OnDiscardClick"
                            VerticalAlignment="Bottom"
                            Background="#5a2c2c" Foreground="#f1d6d6" Padding="8,4"/>
                </Grid>
                <Grid x:Name="_warningsRow" ColumnDefinitions="*,Auto" IsVisible="False">
                    <TextBlock x:Name="_warningsText" Grid.Column="0"
                               Foreground="#cc8800"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,2"
                            ToolTip.Tip="Show missing texture details"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Button.Flyout>
                            <Flyout>
                                <ScrollViewer MaxWidth="380" MaxHeight="360"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="_missingNamesText"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Foreground="#cc8800" />
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                        <micons:MaterialIcon Kind="InformationOutline"
                                             Width="16" Height="16"
                                             Foreground="#cc8800" />
                    </Button>
                </Grid>
                <Button x:Name="_selectBarButton"
                        Content="Select fallback BAR..."
                        Click="SelectBarClick"
                        IsVisible="False"
                        HorizontalAlignment="Stretch"
                        Background="#2c3a4f"
                        Foreground="#cfd8e8"
                        Padding="8,4" />
                <TextBlock x:Name="_manualBarPathText"
                           Foreground="#7e8aa0"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="False" />
            </StackPanel>
        </Border>

        <!-- Scrollable middle: cursor + unified Selected section. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8" Spacing="6">
                <TextBlock Text="Cursor" FontWeight="Bold" Foreground="#888"/>
                <TextBlock x:Name="_cursorInfo" Text="(hover map)" Foreground="#ddd" FontFamily="Cascadia Code,Consolas"/>

                <StackPanel x:Name="_selectedSection" IsVisible="False" Spacing="4" Margin="0,8,0,0">
                    <Separator Background="#333"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="_selectedHeader" Grid.Column="0"
                                   Text="Selected" FontWeight="Bold" Foreground="#888"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="_selectedListButton" Grid.Column="1"
                                Background="Transparent" BorderThickness="0" Padding="6,2"
                                ToolTip.Tip="Show all selected items"
                                Cursor="Hand" VerticalAlignment="Center"
                                IsVisible="False">
                            <Button.Flyout>
                                <Flyout>
                                    <ScrollViewer MaxWidth="380" MaxHeight="360"
                                                  VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="_selectedListText"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="#ddd"/>
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <micons:MaterialIcon Kind="InformationOutline"
                                                 Width="16" Height="16"
                                                 Foreground="#888"/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="_selectedFields" Foreground="#ddd"
                               FontFamily="Cascadia Code,Consolas" TextWrapping="Wrap"
                               IsVisible="False"/>

                    <!-- Entity edit controls. Visible only when Selection.Kind == Entities. -->
                    <StackPanel x:Name="_entityEditPanel" Spacing="6" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Proto" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="#ddd"/>
                            <Button Grid.Column="1" x:Name="_entityProtoBtn"
                                    HorizontalAlignment="Stretch"
                                    Click="OnEntityProtoClick" Content="(none)"
                                    Background="#2c3a4f" Foreground="#cfd8e8" Padding="8,4"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Player" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="#ddd"/>
                            <ComboBox Grid.Column="1" x:Name="_entityPlayerCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnEntityPlayerChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="controls:PlayerOption">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Rectangle Width="14" Height="14" Fill="{Binding Brush}"/>
                                            <TextBlock Text="{Binding Label}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,*,*">
                            <TextBlock Grid.Column="0" Text="Position" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="#ddd"/>
                            <NumericUpDown Grid.Column="1" x:Name="_entityPosX"
                                           FormatString="0.00" Increment="0.5"
                                           ShowButtonSpinner="False"
                                           ValueChanged="OnEntityPosChanged"/>
                            <NumericUpDown Grid.Column="2" x:Name="_entityPosY"
                                           FormatString="0.00" Increment="0.5"
                                           ShowButtonSpinner="False"
                                           ValueChanged="OnEntityPosChanged" Margin="4,0,0,0"/>
                            <NumericUpDown Grid.Column="3" x:Name="_entityPosZ"
                                           FormatString="0.00" Increment="0.5"
                                           ShowButtonSpinner="False"
                                           ValueChanged="OnEntityPosChanged" Margin="4,0,0,0"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Rotation Y" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="#ddd"/>
                            <NumericUpDown Grid.Column="1" x:Name="_entityYaw"
                                           FormatString="0.0"
                                           Minimum="-360" Maximum="360" Increment="5"
                                           ShowButtonSpinner="False"
                                           ValueChanged="OnEntityYawChanged"/>
                        </Grid>
                        <Button x:Name="_entityDeleteBtn" Content="Delete"
                                Click="OnEntityDeleteClick"
                                HorizontalAlignment="Stretch" Margin="0,2,0,0"
                                Background="#5a2c2c" Foreground="#f1d6d6" Padding="8,4"/>
                    </StackPanel>

                    <!-- Tile edit controls. Visible only when Selection.Kind == Tiles. -->
                    <StackPanel x:Name="_tileEditPanel" Spacing="6" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Texture" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="#ddd"/>
                            <Button Grid.Column="1" x:Name="_tileTextureBtn"
                                    HorizontalAlignment="Stretch"
                                    Click="OnTileTextureClick" Content="(none)"
                                    Background="#2c3a4f" Foreground="#cfd8e8" Padding="8,4"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="Water type" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="#ddd"/>
                            <ComboBox Grid.Column="1" x:Name="_tileWaterCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnTileWaterChanged"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Height" Margin="0,0,8,0"
                                       VerticalAlignment="Center" Foreground="#ddd"/>
                            <NumericUpDown Grid.Column="1" x:Name="_tileHeightNum"
                                           FormatString="0.00" Increment="0.25"
                                           ShowButtonSpinner="False"
                                           ValueChanged="OnTileHeightChanged"/>
                            <Button Grid.Column="2" Content="-1"
                                    Click="OnTileHeightDecrement" Margin="4,0,0,0"
                                    Background="#2c3a4f" Foreground="#cfd8e8"/>
                            <Button Grid.Column="3" Content="+1"
                                    Click="OnTileHeightIncrement" Margin="4,0,0,0"
                                    Background="#2c3a4f" Foreground="#cfd8e8"/>
                        </Grid>
                    </StackPanel>

                    <Button x:Name="_selectedClearButton" Content="Clear selection"
                            Click="ClearSelectionClick"
                            HorizontalAlignment="Stretch" Margin="0,4,0,0"
                            Background="#2c3a4f" Foreground="#cfd8e8" Padding="8,4"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
